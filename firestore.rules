rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Candidates are written only by trusted administrators/MOBO. The app
    // validates all numeric bounds before accepting a candidate. Compare the
    // submitted snapshot to that trusted source instead of evaluating the
    // 70 numeric fields again (which exceeds Firestore's expression budget).
    function matchesCandidate(data) {
      let candidate = get(/databases/$(database)/documents/parameterValues/$(data.parameterDocumentId)).data;
      return candidate.pid == data.pid
        && candidate.schemaVersion == data.schemaVersion
        && candidate.phase == data.phase
        && candidate.phaseStep == data.phaseStep
        && candidate.candidateId == data.candidateId
        && data.haptics is map
        && data.haptics.size() == 14
        && data.haptics.keys().hasAll([
          'start', 'onRoute', 'offRoute', 'onRouteIntersection',
          'offRouteIntersection', 'landmark', 'end', 'street',
          'onRouteSidewalk', 'offRouteSidewalk', 'onRouteCrosswalk',
          'offRouteCrosswalk', 'turn', 'intersectionCenter'
        ])
        // MapDiff compares nested numeric values across Int/Double encodings.
        // Plain map == rejects some equivalent values normalized by the app.
        && data.haptics.diff(candidate.haptics).affectedKeys().size() == 0;
    }

    function validResult(data) {
      return data.authUid is string
        && data.pid is string
        && data.resultId is string
        && data.sessionId is string
        && data.parameterDocumentId is string
        && data.candidateId is string
        && data.mapName is string
        && data.createdAt is timestamp
        && data.schemaVersion == 2
        && data.hapticMode == 'burst'
        && data.phase == 'exploration'
        && data.phaseStep is int
        && data.roundNumber is int
        && data.roundNumber >= 1
        && data.roundNumber <= 17
        && data.phaseStep == data.roundNumber
        && data.subjectiveScore is number
        && data.subjectiveScore >= 0
        && data.subjectiveScore <= 1
        && data.objectiveScore is number
        && data.objectiveScore >= 0
        && data.objectiveScore <= 1
        && data.touchedTarget is bool
        && matchesCandidate(data);
    }

    match /parameterValues/{documentId} {
      // The iOS app reads optimizer output but cannot create or alter it.
      // A trusted MOBO Admin SDK is controlled by IAM and bypasses these rules.
      allow read: if signedIn();
      allow write: if false;
    }

    match /interventionResults/{documentId} {
      // A participant can create its own valid result at a deterministic path.
      allow create: if signedIn()
        && validResult(request.resource.data)
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.resultId == documentId;

      // Retrying an ambiguous network write replaces the same logical result,
      // but cannot change its owner, candidate, round, or tested haptic values.
      allow update: if signedIn()
        && resource.data.authUid == request.auth.uid
        && resource.data.resultId == documentId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['createdAt']);

      allow read, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
